{
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 80,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "printWidth": 120,
        "bracketSameLine": true,
        "singleAttributePerLine": false,
        "htmlWhitespaceSensitivity": "css"
      }
    }
  ]
}
